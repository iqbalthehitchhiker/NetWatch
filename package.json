{
  "name": "netwatch",
  "version": "2.0.0",
  "description": "NetWatch — Network Monitoring Trainer (two-tier: Node/Express + modular frontend)",
  "type": "module",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "test": "vitest run",
    "seed:student": "node backend/seed.js",
    "seed:instructor": "node backend/seed.js --role instructor"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "jsonwebtoken": "9.0.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "1.4.0",
    "fast-check": "3.17.2",
    "vitest": "1.4.0"
  }
}
